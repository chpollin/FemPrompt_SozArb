* text=auto eol=lf
*.cmd text eol=crlf

*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.png binary
*.woff2 binary
*.zip binary

# Source captures and generated research artifacts preserve source-exact text.
# Their recorded hashes take precedence over Git's whitespace heuristic.
corpus/deep-research/round2/** -whitespace
corpus/source-acquisition/** -whitespace
generated/markdown/** -whitespace
generated/markdown_clean/** -whitespace
generated/source-acquisition/** -whitespace
tests/review-cases/agent-runs/** -whitespace

# Frozen evaluation records retain the exact bytes used in run and review hashes.
evaluation/paper-2026-10-31/development-v2/** -text -whitespace
evaluation/paper-2026-10-31/sources-v2/manifest.json -text -whitespace
evaluation/paper-2026-10-31/prompts/v2/*.md -text -whitespace
evaluation/paper-2026-10-31/manifest.json -text -whitespace
evaluation/paper-2026-10-31/sources-v2/review.md -text -whitespace
