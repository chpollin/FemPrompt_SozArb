# Historical local acquisition sources, still referenced by source-review records.
# Preserve these paths until a provenance-aware source migration replaces them.
pipeline/

# Local sources and historical outputs retained when consolidating worktrees.
generated/local-source-preservation/

# Pipeline runtime/test artifacts
.pipeline_status.json
generated/conversion_report_*.json
generated/validation_*.json
generated/markdown_test/
conversion_metadata.json

# Third-party source captures stay local. Versioned Markdown and manifests retain
# the reproducible representation and source checksum without publishing raw pages.
generated/source-acquisition/**/*.official.html
generated/source-acquisition/**/html-source/

# Benchmark test data
assessment/test_*.csv
assessment/phase2_test/

# Validation reports (generated artifacts)
generated/validation_reports/
generated/validation_reports_clean/

# Distillate evidence audit (regenerable check artifact, distillate-check-plan.md)
generated/distilled/_evidence_audit/

# API call logs
*.jsonl

# LLM cache (vault generation)
.vault_cache/

# Obsidian per-machine workspace config (layout, plugins, open panes)
generated/vault/.obsidian/

# Backup files
*_old.*
*_backup.*
*_copy.*

# Node (test harness dev dependency only; the app under docs/ stays vanilla)
node_modules/

# Separate result-site build. Deploy this allowlisted artifact, never docs/.
build/

# Local-only full texts for the PRISM reading pane (built by src/publish/build_fulltext.py
# from generated/markdown_clean/). Mostly copyrighted paywalled papers, so the reading pane
# reads them from a local clone but they are NEVER published to the public GitHub Pages site.
# Publishing publicly is a separate, rights-gated decision.
docs/data/fulltext/
docs/data/fulltext_manifest.json

# research-vault protected layers. Third-party full texts and the anchor layer that
# embeds them. Same rights-gated rationale as docs/data/fulltext/, never pushed to the
# public repo. Releasing a single open-access source would be a separate per-source decision.
research-vault/_sources/
research-vault/00_representation/
tests/browser/out/

# Advisory-track intermediates (regenerable via src/analysis/build_advisory_manifest.py; merged into sq_extraction.json)
generated/analysis-advisory/inputs/
generated/analysis-advisory/extract/

# Newly reacquired third-party full texts remain local pending source review.
generated/source-acquisition/audit-*/markdown-new-bytes/

# Rebuilt from source-bound research-vault documents and recovery manifests.
docs/vault/Papers/active-*.md
docs/vault/Papers/recovered-*.md
generated/literature-readiness.json
generated/literature-readiness.csv

# Keep complete publisher captures local; only minimal metadata evidence is versioned.
corpus/source-acquisition/acl-publisher-bindings-2026-09-21/*.html

