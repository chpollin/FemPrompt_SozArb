{
  "name": "femprompt-prisma-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Headless test harness for the framework-free static front end. Runtime libraries are pinned vendor assets; npm dependencies support tests and vendor refreshes only.",
  "type": "module",
  "scripts": {
    "build:literature": "python src/publish/generate_literature_landscape.py",
    "test": "node tests/run.mjs && node tests/companion.mjs",
    "test:prism": "node tests/run.mjs",
    "test:companion": "node tests/companion.mjs",
    "test:browser-companion": "node tests/browser/companion.mjs",
    "pilot": "node tests/browser/pilot.mjs",
    "reconcile": "node tests/browser/reconcile.mjs",
    "verify:agent-track": "node tests/review-cases/verify-agent-track.mjs"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1"
  }
}
