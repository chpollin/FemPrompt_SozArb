{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dhcraft.org/FemPrompt_SozArb/schemas/femprompt-prisma-assignment-1.0.schema.json",
  "title": "femprompt-prisma-assignment/1.0",
  "$comment": "Split of the open PRISM papers between the human reviewers at docs/data/screening/assignment.json. Writer: src/assess/build_assignment.py (append-only). Reader: docs/js/prisma.js (list filter Zuteilung). It is not a reviewer file and carries no decision.",
  "type": "object",
  "required": ["schema", "reviewers", "assigned_on", "rule", "assignments"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "femprompt-prisma-assignment/1.0" },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "label"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,11}$" },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "assigned_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updated_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "rule": { "type": "string", "minLength": 1 },
    "assignments": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,11}$" }
    }
  }
}
