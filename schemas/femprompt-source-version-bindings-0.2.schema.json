{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dhcraft.org/FemPrompt_SozArb/schemas/femprompt-source-version-bindings-0.2.schema.json",
  "title": "femprompt-source-version-bindings/0.2",
  "$comment": "Governed reading-source binding manifest at corpus/source_version_bindings.json. Writer: src/acquire/project_codex_source_bindings.py (projection of reviewed source identities). Reader: src/analysis/build_work_version_registry.py (_apply_source_bindings), which projects each entry into registry.source_index and revalidates it through src/analysis/work_versions.py:source_binding_for_record. The binding_mode 'existing_version' key sets mirror the closed allow-lists the reader enforces, so an entry cannot smuggle in new Version metadata.",
  "type": "object",
  "required": ["schema", "records"],
  "additionalProperties": true,
  "properties": {
    "schema": { "const": "femprompt-source-version-bindings/0.2" },
    "scope": { "type": "string" },
    "records": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/zoteroKey" },
      "additionalProperties": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "sha256Prefixed": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "workId": {
      "type": "string",
      "pattern": "^work:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "versionId": {
      "type": "string",
      "pattern": "^version:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "zoteroKey": {
      "type": "string",
      "pattern": "^[A-Z0-9]{8}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "versionType": {
      "enum": [
        "authors_original",
        "submitted_manuscript_under_review",
        "preprint",
        "working_paper",
        "accepted_manuscript",
        "proof",
        "version_of_record",
        "corrected_version_of_record",
        "enhanced_version_of_record",
        "unknown"
      ]
    },
    "identity": {
      "$comment": "Descriptive identity block. At least the title must be present; the identifier set stays open because a record may be identified by DOI, arXiv revision, report number or URL.",
      "type": "object",
      "required": ["title"],
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "doi": { "type": "string", "pattern": "^10\\.[0-9]{4,9}/\\S+$" },
        "arxiv": {
          "$comment": "An arXiv source identity requires an explicit revision; the arXiv DOI alone identifies no revision.",
          "type": "string",
          "pattern": "^[0-9]{4}\\.[0-9]{4,5}v[0-9]+$"
        },
        "report_number": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "acquisitionReceipt": {
      "$comment": "Where the text came from. A licensed original named by repo_path may stay local; its digest is then retained provenance and re-verified wherever the file is present.",
      "type": "object",
      "required": ["retrieved_at", "sha256"],
      "anyOf": [{ "required": ["source_url"] }, { "required": ["repo_path"] }],
      "additionalProperties": false,
      "properties": {
        "source_url": { "type": "string", "pattern": "^https?://\\S+$" },
        "repo_path": { "type": "string", "minLength": 1 },
        "retrieved_at": { "$ref": "#/$defs/timestamp" },
        "sha256": { "$ref": "#/$defs/sha256Prefixed" },
        "route": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "identityCheck": {
      "$comment": "Result of work_versions.receipt_identity_check on the bound text's opening pages; the builder re-runs it and requires equality. No element may fail, title must pass.",
      "type": "object",
      "required": ["title", "first_author", "doi", "year"],
      "additionalProperties": false,
      "properties": {
        "title": { "const": "pass" },
        "first_author": { "enum": ["pass", "not_registered"] },
        "doi": { "enum": ["pass", "not_printed", "not_registered"] },
        "year": { "enum": ["pass", "not_printed", "not_registered"] }
      }
    },
    "versionRelation": {
      "type": "object",
      "required": ["source_version_type", "preferred_version_id", "difference_to_preferred"],
      "additionalProperties": false,
      "properties": {
        "source_version_type": { "$ref": "#/$defs/versionType" },
        "preferred_version_id": { "$ref": "#/$defs/versionId" },
        "difference_to_preferred": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceItem": {
      "type": "object",
      "required": ["locator", "source_path", "sha256"],
      "additionalProperties": true,
      "properties": {
        "locator": { "type": "string", "minLength": 1 },
        "source_path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256Prefixed" },
        "quote": { "type": "string" },
        "source_url": { "type": "string" }
      }
    },
    "binding": {
      "type": "object",
      "required": [
        "record_id",
        "work_id",
        "bibliographic_version_id",
        "source_version_id",
        "source_version_type",
        "preferred_version_id",
        "is_preferred_version",
        "source_path",
        "source_sha256"
      ],
      "additionalProperties": true,
      "properties": {
        "record_id": { "$ref": "#/$defs/zoteroKey" },
        "work_id": { "$ref": "#/$defs/workId" },
        "bibliographic_version_id": { "$ref": "#/$defs/versionId" },
        "source_version_id": { "$ref": "#/$defs/versionId" },
        "preferred_version_id": { "$ref": "#/$defs/versionId" },
        "source_version_type": { "$ref": "#/$defs/versionType" },
        "is_preferred_version": { "type": "boolean" },
        "source_path": { "type": "string", "minLength": 1 },
        "source_sha256": { "$ref": "#/$defs/sha256Prefixed" },
        "source_url": { "type": "string" }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "agent_id",
        "model",
        "reviewed_at",
        "reason",
        "bibliographic_identity",
        "binding",
        "evidence"
      ],
      "additionalProperties": true,
      "properties": {
        "agent_id": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "model_id_status": { "type": "string" },
        "reviewed_at": { "$ref": "#/$defs/timestamp" },
        "reason": { "type": "string", "minLength": 1 },
        "binding_mode": { "enum": ["accepted_manuscript", "existing_version", "acquisition_receipt"] },
        "acquisition_receipt": { "$ref": "#/$defs/acquisitionReceipt" },
        "identity_check": { "$ref": "#/$defs/identityCheck" },
        "version_relation": { "$ref": "#/$defs/versionRelation" },
        "bibliographic_identity": { "$ref": "#/$defs/identity" },
        "version_identity": { "$ref": "#/$defs/identity" },
        "binding": { "$ref": "#/$defs/binding" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceItem" }
        },
        "publisher_evidence": {
          "type": "object",
          "required": ["path", "sha256"],
          "additionalProperties": true,
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/sha256Prefixed" }
          }
        },
        "version": {
          "$comment": "Only a manuscript-adding binding supplies new Version metadata; see the existing_version branch below.",
          "type": "object",
          "required": ["version_id", "version_type", "title"],
          "additionalProperties": true,
          "properties": {
            "version_id": { "$ref": "#/$defs/versionId" },
            "version_type": { "$ref": "#/$defs/versionType" },
            "title": { "type": "string", "minLength": 1 }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "binding_mode": { "const": "existing_version" } },
            "required": ["binding_mode"]
          },
          "then": {
            "$comment": "Mirrors allowed_entry and allowed_binding in build_work_version_registry._apply_source_bindings: an existing-version binding adds no Work, Version, identifier or relation. The reader rejects any further key, model_id_status included.",
            "required": ["version_identity"],
            "additionalProperties": false,
            "properties": {
              "binding_mode": true,
              "binding": {
                "additionalProperties": false,
                "properties": {
                  "record_id": true,
                  "work_id": true,
                  "bibliographic_version_id": true,
                  "source_version_id": true,
                  "source_version_type": true,
                  "preferred_version_id": true,
                  "is_preferred_version": true,
                  "source_path": true,
                  "source_sha256": true
                }
              },
              "bibliographic_identity": true,
              "version_identity": true,
              "publisher_evidence": true,
              "agent_id": true,
              "model": true,
              "reviewed_at": true,
              "reason": true,
              "evidence": true
            }
          }
        },
        {
          "if": {
            "properties": { "binding_mode": { "const": "acquisition_receipt" } },
            "required": ["binding_mode"]
          },
          "then": {
            "$comment": "Operator decision of 1 October 2026. Mirrors the receipt branch of build_work_version_registry.apply_source_bindings: an acquisition receipt plus a passed, deterministically re-run identity check of the bound text. A 'version' block is present only when the text is a manuscript or preprint added to the record's bibliographic Version.",
            "required": ["acquisition_receipt", "identity_check", "version_relation"],
            "additionalProperties": false,
            "properties": {
              "binding_mode": true,
              "binding": {
                "additionalProperties": false,
                "properties": {
                  "record_id": true,
                  "work_id": true,
                  "bibliographic_version_id": true,
                  "source_version_id": true,
                  "source_version_type": true,
                  "preferred_version_id": true,
                  "is_preferred_version": true,
                  "source_path": true,
                  "source_sha256": true
                }
              },
              "bibliographic_identity": true,
              "acquisition_receipt": true,
              "identity_check": true,
              "version_relation": true,
              "version": true,
              "agent_id": true,
              "model": true,
              "model_id_status": true,
              "reviewed_at": true,
              "reason": true,
              "evidence": true
            }
          }
        },
        {
          "if": {
            "not": {
              "properties": { "binding_mode": { "enum": ["existing_version", "acquisition_receipt"] } },
              "required": ["binding_mode"]
            }
          },
          "then": {
            "$comment": "A manuscript-adding binding carries the new Version it registers.",
            "required": ["version"]
          }
        }
      ]
    }
  }
}
