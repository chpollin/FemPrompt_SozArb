{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dhcraft.org/FemPrompt_SozArb/schemas/femprompt-work-version-registry-0.1.schema.json",
  "title": "femprompt-work-version-registry/0.1",
  "$comment": "Canonical Work-Version identity layer at corpus/work_version_registry.json. Writer: src/analysis/build_work_version_registry.py. Readers: src/analysis/work_versions.py (validate_registry, lookup_by_record, source_binding_for_record), src/publish/generate_docs_data.py, src/analysis/build_completion_package.py, src/analysis/build_agent_screening_queue.py. Controlled vocabularies are owned by docs/data/work_version_contract.json; the enums here mirror it and must be changed together with it. Identity, hash and date fields are pinned; descriptive and provenance blocks stay open.",
  "type": "object",
  "required": [
    "schema",
    "source_fingerprint",
    "counts",
    "works",
    "record_index",
    "candidate_index",
    "identifier_index",
    "legacy_work_id_index",
    "ambiguous_identifiers",
    "source_index",
    "sources"
  ],
  "additionalProperties": true,
  "properties": {
    "schema": { "const": "femprompt-work-version-registry/0.1" },
    "source_fingerprint": { "$ref": "#/$defs/sha256Prefixed" },
    "counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "works": {
      "type": "array",
      "items": { "$ref": "#/$defs/work" }
    },
    "record_index": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/zoteroKey" },
      "additionalProperties": { "$ref": "#/$defs/workVersionReference" }
    },
    "candidate_index": {
      "$comment": "Keyed by intake identifier token (doi:, arxiv:, url:, title:), not by a Zotero key.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifierToken" },
      "additionalProperties": {
        "type": "object",
        "required": ["work_id", "preferred_version_id"],
        "additionalProperties": true,
        "properties": {
          "work_id": { "$ref": "#/$defs/workId" },
          "preferred_version_id": { "$ref": "#/$defs/versionId" }
        }
      }
    },
    "identifier_index": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifierToken" },
      "additionalProperties": { "$ref": "#/$defs/workVersionReference" }
    },
    "legacy_work_id_index": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifierToken" },
      "additionalProperties": { "$ref": "#/$defs/workId" }
    },
    "ambiguous_identifiers": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifierToken" },
      "additionalProperties": {
        "type": "array",
        "minItems": 2,
        "items": { "$ref": "#/$defs/workVersionReference" }
      }
    },
    "source_index": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/zoteroKey" },
      "additionalProperties": { "$ref": "#/$defs/sourceBinding" }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceRef" }
    }
  },
  "$defs": {
    "sha256Prefixed": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "sha256Bare": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "workId": {
      "type": "string",
      "pattern": "^work:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "versionId": {
      "type": "string",
      "pattern": "^version:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "zoteroKey": {
      "type": "string",
      "pattern": "^[A-Z0-9]{8}$"
    },
    "identifierToken": {
      "type": "string",
      "pattern": "^[a-z_]+:.+$"
    },
    "timestamp": {
      "type": "string",
      "$comment": "ISO 8601 with an explicit timezone offset or Z; a naive local timestamp is rejected.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "partialDate": {
      "type": "string",
      "$comment": "Recorded bibliographic date as it stands in the source record. The registry preserves the Zotero date verbatim, so besides year, year-month and full date this also holds slash notation, month names and conference date ranges, and the empty string records an undated version. Year extraction for preferred and latest selection happens in src/analysis/work_versions.py, not through a stored normal form."
    },
    "versionType": {
      "enum": [
        "authors_original",
        "submitted_manuscript_under_review",
        "preprint",
        "working_paper",
        "accepted_manuscript",
        "proof",
        "version_of_record",
        "corrected_version_of_record",
        "enhanced_version_of_record",
        "unknown"
      ]
    },
    "workVersionReference": {
      "type": "object",
      "required": ["work_id", "version_id"],
      "additionalProperties": false,
      "properties": {
        "work_id": { "$ref": "#/$defs/workId" },
        "version_id": { "$ref": "#/$defs/versionId" }
      }
    },
    "sourceRef": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256Bare" }
      }
    },
    "work": {
      "type": "object",
      "required": [
        "work_id",
        "canonical_title",
        "identity_status",
        "latest_version_id",
        "preferred_version_id",
        "legacy_work_ids",
        "flags",
        "review_status",
        "versions"
      ],
      "additionalProperties": true,
      "properties": {
        "work_id": { "$ref": "#/$defs/workId" },
        "canonical_title": { "type": "string" },
        "identity_status": { "enum": ["curated", "conflict"] },
        "latest_version_id": { "$ref": "#/$defs/versionId" },
        "preferred_version_id": { "$ref": "#/$defs/versionId" },
        "legacy_work_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifierToken" }
        },
        "flags": { "type": "array", "items": { "type": "string" } },
        "source_lanes": { "type": "array", "items": { "type": "string" } },
        "review_status": {
          "type": "object",
          "required": ["identity", "metadata", "source"],
          "additionalProperties": true,
          "properties": {
            "identity": { "enum": ["unreviewed", "confirmed", "conflict"] },
            "metadata": { "enum": ["unreviewed", "confirmed", "conflict"] },
            "source": {
              "enum": [
                "unreviewed",
                "fulltext_available",
                "abstract_only",
                "ambiguous"
              ]
            }
          }
        },
        "source_hold": {
          "type": "object",
          "required": ["kind", "reason", "artifact", "sha256", "reviewed_at"],
          "additionalProperties": true,
          "properties": {
            "kind": { "enum": ["source_version_hold", "integrity_hold"] },
            "reason": { "type": "string", "minLength": 1 },
            "artifact": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/sha256Prefixed" },
            "reviewed_at": { "$ref": "#/$defs/timestamp" },
            "agent_id": { "type": "string" },
            "model": { "type": "string" }
          }
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/version" }
        }
      }
    },
    "version": {
      "type": "object",
      "required": [
        "version_id",
        "title",
        "authors",
        "version_type",
        "version_date",
        "identifiers",
        "access_status",
        "peer_review_status",
        "peer_review_basis",
        "integrity_status",
        "relations",
        "provenance"
      ],
      "additionalProperties": true,
      "properties": {
        "version_id": { "$ref": "#/$defs/versionId" },
        "title": { "type": "string" },
        "authors": { "type": "array", "items": { "type": "string" } },
        "version_type": { "$ref": "#/$defs/versionType" },
        "version_date": { "$ref": "#/$defs/partialDate" },
        "item_type": { "type": "string" },
        "journal_or_repository": { "type": "string" },
        "landing_url": { "type": "string" },
        "fulltext_url": { "type": "string" },
        "license": { "type": "string" },
        "identifiers": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "doi": { "type": "array", "items": { "type": "string" } },
            "arxiv": { "type": "array", "items": { "type": "string" } },
            "url": { "type": "array", "items": { "type": "string" } },
            "zotero_key": {
              "type": "array",
              "items": { "$ref": "#/$defs/zoteroKey" }
            }
          }
        },
        "access_status": {
          "enum": ["open_access", "restricted", "unknown"]
        },
        "peer_review_status": {
          "enum": [
            "peer_reviewed",
            "under_review",
            "not_peer_reviewed",
            "not_established"
          ]
        },
        "peer_review_basis": {
          "enum": [
            "source_metadata",
            "publisher_metadata",
            "version_stage_inference",
            "unknown"
          ]
        },
        "integrity_status": {
          "enum": ["current", "corrected", "withdrawn", "retracted", "unknown"]
        },
        "flags": { "type": "array", "items": { "type": "string" } },
        "source_lanes": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "type": "object" } },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "target_version_id"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "isPreprintOf",
                  "hasPreprint",
                  "isVersionOf",
                  "hasVersion",
                  "supersedes",
                  "isSupersededBy"
                ]
              },
              "target_version_id": { "$ref": "#/$defs/versionId" }
            }
          }
        },
        "provenance": {
          "$comment": "Open by intent: each entry records where a metadata state came from, including nested AI metadata corrections whose hash fields are pinned below.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "reference"],
            "additionalProperties": true,
            "properties": {
              "source": { "type": "string", "minLength": 1 },
              "reference": { "type": "string" },
              "reviewed_at": { "$ref": "#/$defs/timestamp" },
              "ai_metadata_correction": {
                "type": "object",
                "required": [
                  "record_id",
                  "base_sha256",
                  "reviewed_at",
                  "changes",
                  "evidence"
                ],
                "additionalProperties": true,
                "properties": {
                  "record_id": { "$ref": "#/$defs/zoteroKey" },
                  "base_sha256": { "$ref": "#/$defs/sha256Prefixed" },
                  "reviewed_at": { "$ref": "#/$defs/timestamp" },
                  "authority": { "type": "string" },
                  "changes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["field", "reason"],
                      "additionalProperties": true,
                      "properties": {
                        "field": { "type": "string", "minLength": 1 },
                        "reason": { "type": "string", "minLength": 1 }
                      }
                    }
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["locator", "sha256", "source_path"],
                      "additionalProperties": true,
                      "properties": {
                        "locator": { "type": "string", "minLength": 1 },
                        "sha256": { "$ref": "#/$defs/sha256Prefixed" },
                        "source_path": { "type": "string", "minLength": 1 }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "sourceBinding": {
      "$comment": "Projection of corpus/source_version_bindings.json into the registry; see femprompt-source-version-bindings-0.2.schema.json for the manifest form.",
      "type": "object",
      "required": [
        "record_id",
        "work_id",
        "bibliographic_version_id",
        "source_version_id",
        "source_version_type",
        "preferred_version_id",
        "is_preferred_version",
        "source_path",
        "source_sha256"
      ],
      "additionalProperties": true,
      "properties": {
        "record_id": { "$ref": "#/$defs/zoteroKey" },
        "work_id": { "$ref": "#/$defs/workId" },
        "bibliographic_version_id": { "$ref": "#/$defs/versionId" },
        "source_version_id": { "$ref": "#/$defs/versionId" },
        "preferred_version_id": { "$ref": "#/$defs/versionId" },
        "source_version_type": { "$ref": "#/$defs/versionType" },
        "is_preferred_version": { "type": "boolean" },
        "source_path": { "type": "string", "minLength": 1 },
        "source_sha256": { "$ref": "#/$defs/sha256Prefixed" },
        "source_url": { "type": "string" },
        "binding_mode": { "enum": ["accepted_manuscript", "existing_version"] },
        "bibliographic_identity": { "type": "object" },
        "version_identity": { "type": "object" }
      }
    }
  }
}
